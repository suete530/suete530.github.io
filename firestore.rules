rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Password/Google accounts only — anonymous (guest) tokens have no 'email' claim.
    function isEmailUser() {
      return request.auth != null && 'email' in request.auth.token;
    }

    function isAdmin() {
      let cfg = get(/databases/$(database)/documents/settings/admin).data;
      let registeredEmail = cfg.get('adminEmail', '');
      let registeredUid = cfg.get('adminUid', '');
      let isOwner = isEmailUser() && (
        (registeredUid != '' && request.auth.uid == registeredUid)
        || (registeredEmail != '' && request.auth.token.email == registeredEmail)
      );
      let isApprovedAdmin = isEmailUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('status', '') == 'approved';
      return isOwner || isApprovedAdmin;
    }

    function isOwner() {
      let cfg = get(/databases/$(database)/documents/settings/admin).data;
      let registeredEmail = cfg.get('adminEmail', '');
      let registeredUid = cfg.get('adminUid', '');
      return isEmailUser() && (
        (registeredUid != '' && request.auth.uid == registeredUid)
        || (registeredEmail != '' && request.auth.token.email == registeredEmail)
      );
    }

    // Any signed-in email user can register as admin (status=pending).
    // Only the owner can approve/revoke/update other admins.
    match /admins/{adminUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == adminUid);
      // Self-registration: create own doc with status 'pending'.
      allow create: if isEmailUser()
                    && request.auth.uid == adminUid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Owner can approve, revoke, or update any admin doc.
      // Pending admin can only cancel their own request (delete).
      allow update: if isOwner();
      allow delete: if isOwner() || (signedIn() && request.auth.uid == adminUid);
    }

    function isSecretary() {
      return isEmailUser() && exists(/databases/$(database)/documents/secretaries/$(request.auth.uid))
        && get(/databases/$(database)/documents/secretaries/$(request.auth.uid)).data.get('status', '') == 'approved';
    }

    // Secretary accounts: self-register as pending; ONLY the owner (developer)
    // may approve, reject or remove a secretary account. Delegated treasurers
    // (admins/{uid}) are admins but never owners.
    match /secretaries/{secUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == secUid);
      allow create: if isEmailUser()
                    && request.auth.uid == secUid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Owner manages the account status; the secretary may only change
      // their own profile photo.
      allow update: if isOwner()
                    || (isEmailUser() && request.auth.uid == secUid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl']));
      allow delete: if isOwner() || (signedIn() && request.auth.uid == secUid);

      // Secretary's own student roster (attendance page).
      match /students/{studentId} {
        allow read, write: if isSecretary() && request.auth.uid == secUid;
      }
      // Secretary's daily attendance records (doc id = YYYY-MM-DD).
      match /attendance/{date} {
        allow read, write: if isSecretary() && request.auth.uid == secUid;
      }
    }

    // Per-email secretary profile used by the login screen: as soon as a
    // secretary types their email, the login page shows THEIR OWN photo and
    // name. Public single-document read (same exposure as settings/admin);
    // collection queries stay admin-only.
    match /secretary_profiles/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isEmailUser()
                    && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if isAdmin()
                    || (isEmailUser()
                        && resource.data.email.lower() == request.auth.token.email.lower()
                        && request.resource.data.email.lower() == request.auth.token.email.lower());
      allow delete: if isAdmin()
                    || (isEmailUser() && resource.data.email.lower() == request.auth.token.email.lower());
    }

    // Per-email treasurer profile used by the login screen: as soon as a
    // treasurer types their email, the login page shows THEIR OWN photo and
    // name. Public single-document read (same exposure as settings/admin);
    // collection queries stay admin-only.
    match /treasurer_profiles/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isEmailUser()
                    && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if isAdmin()
                    || (isEmailUser()
                        && resource.data.email.lower() == request.auth.token.email.lower()
                        && request.resource.data.email.lower() == request.auth.token.email.lower());
      allow delete: if isAdmin()
                    || (isEmailUser() && resource.data.email.lower() == request.auth.token.email.lower());
    }

    function visitorCountOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitorCount']);
    }

    // Identity of the owner/developer. A delegated treasurer is an admin but
    // must never overwrite the owner's name, photo or email.
    function touchesOwnerIdentity() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['adminEmail', 'adminUid', 'adminName', 'adminPhoto', 'devName', 'devPhoto', 'secName', 'secPhoto']);
    }

    function selfEditableStudentFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'gender', 'relationStatus', 'lastOnline', 'photoUrl']);
    }

    // True when the signed-in user has a users/{uid} doc linked to this student.
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myStudentId() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('studentId', '');
    }

    function isLinkedStudent(studentId) {
      return isEmailUser() && hasUserDoc() && myStudentId() == studentId;
    }

    // Admin profile / app settings. Login screen reads this BEFORE sign-in
    // (visitor count, background), so read is public — same exposure the app
    // already had via anonymous auth. adminEmail only records WHICH Firebase
    // account is the admin; no password lives here.
    match /settings/admin {
      allow read: if true;
      // First-time setup: a brand-new email/password account bootstraps the
      // doc. After adminRegistered is true, only the registered admin can write.
      allow create: if isEmailUser();
      allow update: if (isEmailUser() && resource.data.get('adminRegistered', false) != true)
                    || visitorCountOnly()
                    || isOwner()
                    // Delegated treasurers may change the shared app settings
                    // (GCash, backgrounds, toggles) but not the owner identity.
                    || (isAdmin() && !touchesOwnerIdentity())
                    // A secretary may only publish their own login wallpaper.
                    // Their photo/name live in secretary_profiles/{email},
                    // so no secretary can overwrite the shared login profile.
                    || (isSecretary() && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['loginBgSec']));
      allow delete: if isAdmin();
    }

    // Section names are needed on the login screen (registration dropdown).
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      // Self-edit: only the linked account holder, and only profile fields.
      // Fine, payment, status and section changes stay admin-only.
      // The third clause lets an owner DELETE a legacy 'pw' field (field must
      // end up absent — a password can never be written through this path).
      allow update: if isAdmin()
                    || (isLinkedStudent(studentId) && selfEditableStudentFields())
                    || (isLinkedStudent(studentId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pw'])
                        && !('pw' in request.resource.data));
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Auth-to-student link. Only the admin can create it (at approval time),
    // so nobody can claim a student record by themselves.
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{announceId} {
      allow read: if signedIn();
      allow create: if isEmailUser();
      allow update, delete: if isAdmin();
    }

    match /suggestions/{suggestId} {
      allow read: if signedIn();
      allow create: if isEmailUser();
      allow update, delete: if isAdmin();
    }

    // Student account requests. Doc id == requester uid, so a student can
    // only read/cancel their OWN request; the admin reads all of them.
    match /account_requests/{reqId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == reqId);
      allow create: if isEmailUser()
                    && request.auth.uid == reqId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == reqId);
    }

    // Chats: the admin or the linked owner of that conversation only.
    match /chats/{chatId} {
      allow read: if isAdmin() || isLinkedStudent(chatId);
      allow create: if isAdmin()
                    || (isLinkedStudent(chatId) && request.resource.data.studentId == chatId);
      // A student may only append messages — studentId/studentName are locked.
      allow update: if isAdmin()
                    || (isLinkedStudent(chatId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages']));
      allow delete: if isAdmin();
    }

    // Activity log: any signed-in account holder, never guests/anonymous.
    match /activity_logs/{logId} {
      allow read, create: if isEmailUser();
      allow update, delete: if isAdmin();
    }
  }
}
